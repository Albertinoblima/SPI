{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Web - Next.js 14 (App Router)",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [
      { "name": "next" }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@political-research/shared-types": [
        "../../packages/shared-types/src/index.ts"
      ],
      "@political-research/shared-utils": [
        "../../packages/shared-utils/src/index.ts"
      ],
      "@political-research/shared-validations": [
        "../../packages/shared-validations/src/index.ts"
      ]
    },
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}